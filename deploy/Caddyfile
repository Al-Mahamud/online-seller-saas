# HTTPS in front of the app (deploy/compose.yml). Caddy gets and renews the certificate for
# APP_DOMAIN from Let's Encrypt by itself, and sends http:// visitors to https://.
{
	email {$ACME_EMAIL}
}

# The web app's own headers. Its scripts, styles, fonts and images all come from this server, and
# it talks only to this server's API, and to Sentry when WEB_SENTRY_ORIGIN says where that is. Inline
# styles stay allowed: toasts and menus set them.
(web_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' {$WEB_SENTRY_ORIGIN}; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	# Imports are up to 10 MB (the app checks each kind of upload itself).
	request_body {
		max_size 12MB
	}

	# The API and its health check go to the app; the app's own headers (CSP, HSTS, ...) apply.
	@api path /api/* /healthz /healthz/*
	handle @api {
		reverse_proxy app:8080
	}

	# The web app's built files (the mojud-web image). Their names change with their content, so
	# browsers keep them for a year; a missing one is a 404, never index.html.
	handle /assets/* {
		root * /srv/web
		import web_headers
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is the web app: its other files, and index.html for its own routes
	# (/products, /orders/new). Checked on every visit, so an update reaches everyone at once.
	handle {
		root * /srv/web
		import web_headers
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header -Server
	log
}

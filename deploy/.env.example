# Copy to .env (next to compose.yml) and fill in. Keep .env private: it holds every secret.
# Passwords and keys: generate each one, never reuse (commands shown).

# The address of the app (a DNS A record pointing at this server), and who gets certificate notices.
APP_DOMAIN=app.example.com
ACME_EMAIL=you@example.com

# The image to run; pin a commit (ghcr.io/al-mahamud/mojud-backend:<commit>) to choose versions.
APP_IMAGE=ghcr.io/al-mahamud/mojud-backend:latest
# The web app (Caddy with the built files), pinned the same way.
WEB_IMAGE=ghcr.io/al-mahamud/mojud-web:latest

# Database. Letters and digits only, 24 or more: openssl rand -hex 24
POSTGRES_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DB_SYSTEM_PASSWORD=

# Encrypts secrets stored in the database (authenticator secrets): openssl rand -base64 32
# Losing it means everyone must set up two-step sign-in again; keep a copy with the backup key.
ENCRYPTION_KEY=
# Only while rotating ENCRYPTION_KEY: the old key (docs/operations.md, "Rotating secrets").
ENCRYPTION_KEY_PREVIOUS=

# Email (sign-up codes, invites, reminders, receipts). Any SMTP provider: Brevo, Amazon SES, ...
# Until set, nobody can receive a code: keep EMAIL_PROVIDER=none only before launch.
EMAIL_PROVIDER=smtp
EMAIL_FROM=Mojud <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Uploaded images: a private Cloudflare R2 bucket (R2 > Manage API tokens: Object Read & Write,
# this bucket only). Endpoint: https://<account id>.r2.cloudflarestorage.com
STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=mojud-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Paying for plans by card or bKash. Sandbox until going live (https://securepay.sslcommerz.com).
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Errors (sentry.io > project > Client Keys). Empty: errors are only in the log.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Backups: a second, separate R2 bucket, with its own token (Object Read & Write, that bucket).
# AGE_RECIPIENT is the public half of the backup key, made on YOUR computer, not the server:
#   age-keygen -o mojud-backup-key.txt   (prints "Public key: age1...")
# Keep mojud-backup-key.txt offline (two copies); without it backups cannot be read.
AGE_RECIPIENT=
BACKUP_REMOTE=r2:mojud-backups/db
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# When (UTC; 20:30 is 02:30 in Dhaka), how long to keep, and an optional "it worked" ping
# (healthchecks.io or Better Stack heartbeat: alerts you when a night is missed).
BACKUP_AT=20:30
BACKUP_KEEP_DAYS=30
BACKUP_PING_URL=
